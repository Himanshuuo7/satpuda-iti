# Copy to .env and adjust.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/satpuda_iti
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Admin dashboard login password.
ADMIN_PASSWORD=change-me
# Secret used to sign admin session tokens. Use a long random string.
TOKEN_SECRET=replace-with-a-long-random-string
# How long an admin session lasts, in hours.
TOKEN_TTL_HOURS=12
